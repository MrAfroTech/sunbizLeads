{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/tickets",
      "destination": "/allevents.html"
    },
    {
      "source": "/tickets/",
      "destination": "/allevents.html"
    },
    {
      "source": "/success",
      "destination": "/success.html"
    },
    {
      "source": "/payment",
      "destination": "/payment.html"
    },
    {
      "source": "/allevents",
      "destination": "/allevents.html"
    },
    {
      "source": "/((?!api/|styles/|js/|images/|assets/|gallery/).*)",
      "destination": "/index.html"
    }
  ]
}
